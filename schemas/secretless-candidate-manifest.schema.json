{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Secretless Current-SHA Candidate Manifest",
  "description": "R83 Step 14: current push identity, immutable image content, runtime configuration, restore identities, and evidence digests",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "source_sha",
    "tree_sha",
    "run_id",
    "run_attempt",
    "workflow_path",
    "event",
    "ref",
    "conclusion",
    "image_digest",
    "runtime_config_digest",
    "artifact_identity",
    "backup_id",
    "restore_operation_id",
    "source_database_identity",
    "target_database_identity",
    "artifacts",
    "generated_at",
    "payload_digest",
    "signature_identity",
    "signature"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "secretless-candidate-manifest/v1"},
    "kind": {"type": "string", "const": "secretless-candidate-manifest"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[0-9]+$"},
    "run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
    "workflow_path": {"type": "string", "const": ".github/workflows/secretless-contract-e2e.yml"},
    "event": {"type": "string", "const": "push"},
    "ref": {"type": "string", "pattern": "^refs/(heads|tags)/[^\\s]+$"},
    "conclusion": {"type": "string", "const": "success"},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runtime_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact_identity": {
      "type": "object",
      "required": ["workflow_path", "run_id", "run_attempt", "event", "source_sha"],
      "properties": {
        "workflow_path": {"type": "string", "const": ".github/workflows/secretless-contract-e2e.yml"},
        "run_id": {"type": "string", "pattern": "^[0-9]+$"},
        "run_attempt": {"type": "string", "pattern": "^[0-9]+$"},
        "event": {"type": "string", "const": "push"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "backup_id": {"type": "string", "minLength": 1},
    "restore_operation_id": {"type": "string", "minLength": 1},
    "source_database_identity": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "target_database_identity": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature_identity": {"type": "string", "pattern": "^secretless-run-[0-9]+-[0-9]+$"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RC Candidate Manifest",
  "description": "R74 §10.9: Strict candidate manifest schema for RC-to-production promotion",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "rc_tag",
    "tag_object_sha",
    "peeled_commit",
    "source_sha",
    "tree_sha",
    "run_id",
    "run_attempt",
    "workflow_path",
    "event",
    "ref",
    "conclusion",
    "image_digest",
    "image_repo_digest",
    "runtime_config_digest",
    "oci_manifest_digest",
    "sbom_digest",
    "provenance_digest",
    "real_transaction_digest",
    "backup_restore_digest",
    "switch_rollback_digest",
    "runtime_e2e_digest",
    "verify_3x_result",
    "break_glass_status",
    "generated_at",
    "payload_digest",
    "signature_identity",
    "signature"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0", "minLength": 1},
    "kind": {"type": "string", "const": "rc-candidate-manifest", "minLength": 1},
    "rc_tag": {"type": "string", "pattern": "^rc-v\\d+\\.\\d+\\.\\d+$", "minLength": 1},
    "tag_object_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 1},
    "peeled_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 1},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 1},
    "tree_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[0-9]+$", "minLength": 1},
    "run_attempt": {"type": "string", "pattern": "^[0-9]+$", "minLength": 1},
    "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/release-gates\\.yml$", "minLength": 1},
    "event": {"type": "string", "const": "push", "minLength": 1},
    "ref": {"type": "string", "pattern": "^refs/tags/rc-v\\d+\\.\\d+\\.\\d+$", "minLength": 1},
    "conclusion": {"type": "string", "const": "success", "minLength": 1},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "image_repo_digest": {"type": "string", "pattern": "^ghcr\\.io/.+@sha256:[0-9a-f]{64}$", "minLength": 1},
    "runtime_config_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "oci_manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "sbom_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "real_transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "backup_restore_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "switch_rollback_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "runtime_e2e_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "verify_3x_result": {"type": "string", "const": "success", "minLength": 1},
    "break_glass_status": {"type": "string", "const": "closed", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time", "minLength": 1},
    "payload_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 1},
    "signature_identity": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}

# ============================================================
#  TG文件解码器机器人系统 - 环境变量配置文件
#  使用方式: 复制此文件为 .env 并填入真实值
# ============================================================

# -------------------------------------------------------
#  机器人 Token（必填，从 @BotFather 获取，每行一个）
#  将对应机器人的 Bot Token 填入，暂不需要的留空即可
# -------------------------------------------------------
UPLOAD_BOT_TOKEN=YOUR_UPLOAD_BOT_TOKEN
DECODER_BOT_TOKEN=YOUR_DECODER_BOT_TOKEN
SENDER_BOT_TOKEN=YOUR_SENDER_BOT_TOKEN
BACKUP_BOT_1_TOKEN=
BACKUP_BOT_2_TOKEN=
BACKUP_BOT_3_TOKEN=

# -------------------------------------------------------
#  频道 ID（必填，Telegram 频道数字 ID，负值）
# -------------------------------------------------------
# 主存储频道：上传机器人将用户文件转存到这里（Telegram 频道）
# 获取方式：在 Telegram 频道中转发任意消息给 @userinfobot 或 @getidsbot 即可看到
MAIN_STORAGE_CHANNEL_ID=-1000000000000
# 解码机器人自身的用户ID（用于接收上传机器人的内部通知消息）
DECODER_BOT_CHAT_ID=000000000

# -------------------------------------------------------
#  备份频道分组（视频文件通过 Telegram 频道转发备份）
#  对应 BACKUP_BOT_N_TOKEN 为空时，该组自动跳过
# -------------------------------------------------------
# 备份机器人1负责的频道列表（JSON 数组，留空则不使用）
BACKUP_CHANNELS_GROUP_1=[]
# 备份机器人2负责的频道列表（JSON 数组，留空则不使用）
BACKUP_CHANNELS_GROUP_2=[]
# 备份机器人3负责的频道列表（JSON 数组，留空则不使用）
BACKUP_CHANNELS_GROUP_3=[]

# -------------------------------------------------------
#  Cloudflare D1 数据库配置
#
#  获取步骤：
#  1. 登录 https://dash.cloudflare.com
#  2. 右上角头像 → My Profile → API Tokens → Create Token
#     → 使用 "Edit Cloudflare Workers" 模板（或新建自定义令牌）
#     → 权限勾选 Account: D1:Edit / Workers KV:Edit
#     → 创建后将 Token 填入 D1_API_TOKEN
#  3. 左侧菜单 Workers & Pages → D1 → Create Database
#     → 输入数据库名称（如 tgjiema-db）
#     → 创建完成后点击数据库 → Settings → Database ID，填入 D1_DATABASE_ID
#  4. Dashboard 首页右侧 Account ID，填入 D1_ACCOUNT_ID
# -------------------------------------------------------
D1_ACCOUNT_ID=
D1_DATABASE_ID=
D1_API_TOKEN=

# -------------------------------------------------------
#  Cloudflare R2 对象存储配置（用于 D1 数据库定期备份）
#
#  获取步骤：
#  1. 登录 https://dash.cloudflare.com
#  2. 左侧菜单 R2 Object Storage → Manage R2 API Tokens
#     → Create API Token
#     → Token name 随意填，权限选择 "Edit"
#     → 创建后得到 Access Key ID 和 Secret Access Key
#     → 填入下方 R2_ACCESS_KEY_ID 和 R2_SECRET_ACCESS_KEY
#  3. R2 Object Storage → 创建一个存储桶（如 tgjiema-backup）
#     → 填入 R2_BUCKET_NAME
#  4. Dashboard 首页右侧 Account ID，填入 R2_ACCOUNT_ID
#  5. R2_ENDPOINT 留空使用默认域名，或填入自定义域名（需已绑定）
# -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tgjiema-backup
R2_ENDPOINT=

# -------------------------------------------------------
#  D1 数据库备份到 R2 配置
# -------------------------------------------------------
# 是否启用数据库定期备份（设为 false 可完全禁用）
DB_BACKUP_ENABLED=false
# 备份间隔（分钟），DB_BACKUP_ENABLED=true 时生效
DB_BACKUP_INTERVAL_MINUTES=60

# -------------------------------------------------------
#  Web 管理后台配置
# -------------------------------------------------------
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -------------------------------------------------------
#  会员每日解码次数配额（-1 表示不限）
# -------------------------------------------------------
FREE_DAILY_QUOTA=3
BASIC_DAILY_QUOTA=20
PREMIUM_DAILY_QUOTA=-1

# -------------------------------------------------------
#  外部码每日配额（0=禁止，-1=不限）
# -------------------------------------------------------
FREE_EXTERNAL_DAILY_QUOTA=0
BASIC_EXTERNAL_DAILY_QUOTA=-1
PREMIUM_EXTERNAL_DAILY_QUOTA=-1

# -------------------------------------------------------
#  文件码格式
# -------------------------------------------------------
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  速率限制
# -------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_PER_USER_PER_MINUTE=10

# -------------------------------------------------------
#  日志级别
# -------------------------------------------------------
LOG_LEVEL=INFO

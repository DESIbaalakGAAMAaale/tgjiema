# ============================================================
#  TG文件解码器 — 环境变量配置
# 架构：环形冗余 v2（5 Bot + Admin Web + DB Backup）
# File Bot 已独立部署至 Cloudflare Workers，不在 VPS 运行
#
# 部署流程：
#   1. SSH 登录 VPS，git clone 本仓库
#   2. cp .env.example .env 并编辑 .env 填入下面配置
#   3. 运行 bash deploy_vps_per_bot.sh（自动安装依赖、创建 systemd 服务）
#   4. 脚本自动启动全部服务
# ============================================================

# -------------------------------------------------------
#  机器人 Token（必填）
#  从 @BotFather 创建机器人后获取 Token，填入对应行
# -------------------------------------------------------

# Upload Bot — 接收用户上传文件的入口 Bot
# 用户把文件发给它，它负责接收并转发到存储频道
UPLOAD_BOT_TOKEN=YOUR_UPLOAD_BOT_TOKEN

# Decoder Bot — 文件码生成与解码 Bot
# 接收上传的文件生成文件码，也负责解码外部链接/文件码
DECODER_BOT_TOKEN=YOUR_DECODER_BOT_TOKEN

# Sender Bot — 文件分发 Bot（唯一出口）
# 从 jobs 表取任务，通过媒体组形式批量发送文件给用户
SENDER_BOT_TOKEN=YOUR_SENDER_BOT_TOKEN

# Admin Bot — 管理员控制面板
# 提供管理界面：频道配置、用户管理、中继账号、系统监控等
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN

# Mon Bot — 频道健康监控 Bot
# 自动检测存储频道状态，触发降级（Active→Shadow1→Shadow2）
MON_BOT_TOKEN=YOUR_MON_BOT_TOKEN

# 管理员 Telegram ID（用于权限控制，从 @userinfobot 获取）
ADMIN_TELEGRAM_ID=0

# -------------------------------------------------------
#  账号频道配置（必填，环形冗余拓扑）
#  5 个 Telegram 账号 × 9 个频道 = 45 个频道 = 15 组
#  每组包含 Active + Shadow1 + Shadow2，各来自不同账号
#
#  CHANNELS 格式：逗号分隔的频道 ID（负数，如 -1001234567890）
#  获取频道 ID：把频道添加到私聊 @RawDataBot 即可查看
# -------------------------------------------------------

# 账号 1 名称（可选，不填则默认"账号1"）
ACCOUNT_1_NAME=
# 账号 1 频道（9 个频道 ID，逗号分隔）
ACCOUNT_1_CHANNELS=-100XXXXXXXXXX,-100XXXXXXXXXX,...

# 账号 2 名称
ACCOUNT_2_NAME=
# 账号 2 频道（9 个频道 ID，逗号分隔）
ACCOUNT_2_CHANNELS=-100XXXXXXXXXX,-100XXXXXXXXXX,...

# 账号 3 名称
ACCOUNT_3_NAME=
# 账号 3 频道（9 个频道 ID，逗号分隔）
ACCOUNT_3_CHANNELS=-100XXXXXXXXXX,-100XXXXXXXXXX,...

# 账号 4 名称
ACCOUNT_4_NAME=
# 账号 4 频道（9 个频道 ID，逗号分隔）
ACCOUNT_4_CHANNELS=-100XXXXXXXXXX,-100XXXXXXXXXX,...

# 账号 5 名称
ACCOUNT_5_NAME=
# 账号 5 频道（9 个频道 ID，逗号分隔）
ACCOUNT_5_CHANNELS=-100XXXXXXXXXX,-100XXXXXXXXXX,...

# R100 兜底存档频道（永不自降，不参与环形调度）
R100_CHANNEL=0

# -------------------------------------------------------
#  CockroachDB 数据库（必填）
#  集群地址，格式：postgresql://user:password@host:26257/defaultdb?sslmode=require
#  如果是托管集群，加上 options=--cluster=your-cluster-name
#
#  R41 RU 门禁: COCKROACHDB_URL 仅以下服务可读取:
#    - services/crdb_sync_service.py(独占同步 dirty_outbox → CRDB)
#    - services/migration_runner.py(DDL 执行)
#    - services/bootstrap_runner.py(显式人工恢复任务,独立 systemd oneshot)
#    - services/disaster_recovery.py(灾备恢复,显式触发)
#  业务 Bot(up_bot/idx_bot/dsp_bot/admin_bot)、db_writer 不持有 CRDB URL,
#  通过 SERVICE_ROLE 环境变量门禁校验(只读 SQLite 本地权威状态)。
#  目标:业务 Bot RU = 0,总空载理想 ≤20 RU/天,上限 ≤100 RU/天。
# -------------------------------------------------------
COCKROACHDB_URL=postgresql://user:password@host:26257/defaultdb?sslmode=require

# R41 RU 门禁: 同步批量大小的环境变量(默认 100,范围 100-500)
# 用于 _sync_dirty_outbox 合并最高 version 后批量 UPSERT 到 CRDB
CRDB_SYNC_BATCH_SIZE=100

# R41 RU 门禁: 业务 Bot 空载 RU 每日告警阈值
# 超过此值时 prometheus_exporter 暴露 tgjiema_crdb_idle_ru_daily gauge 告警
CRDB_IDLE_RU_DAILY_ALERT_THRESHOLD=100

# -------------------------------------------------------
#  Web 管理后台（必填，否则后台不可用）
# -------------------------------------------------------

# 监听地址和端口
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8080

# 登录凭据（必须修改默认值）
ADMIN_USERNAME=admin
# ADMIN_PASSWORD 支持两种格式：
#   1. 明文（默认，便于部署）
#   2. PBKDF2 哈希（推荐，防 .env 泄露时密码暴露）
#      格式: $pbkdf2-sha256$<iterations>$<salt_hex>$<hash_hex>
#      生成命令（部署机上执行）:
#      python -c "import hashlib,secrets; p='YOUR_PASSWORD'; s=secrets.token_bytes(16); h=hashlib.pbkdf2_hmac('sha256', p.encode(), s, 200000); print(f'\$pbkdf2-sha256\$200000\${s.hex()}\${h.hex()}')"
#      或在项目根目录执行:
#      python -c "from admin import generate_password_hash; print(generate_password_hash('YOUR_PASSWORD'))"
ADMIN_PASSWORD=CHANGE_ME_NOW

# -------------------------------------------------------
# Bot 公开用户名（可选，不带 @）
# 用于采集器外部中继和 file_bot 引导消息
UPLOAD_BOT_USERNAME=upload_bot_username
DECODER_BOT_USERNAME=decoder_bot_username
SENDER_BOT_USERNAME=sender_bot_username

# -------------------------------------------------------
#  强制关注频道（可选，设为 0 则禁用）
#  用户解码前必须加入此频道，通过 admin_bot /set_force_join 可热更新
# -------------------------------------------------------
FORCE_JOIN_CHANNEL_ID=0
FORCE_JOIN_CHANNEL_LINK=https://t.me/your_channel

# -------------------------------------------------------
#  Cloudflare R2 对象存储（可选，用于数据库定期备份）
#
#  获取步骤：
#    1. 登录 Cloudflare Dashboard → 左侧 R2 Object Storage
#    2. 点击 Create bucket，名称填入下方 R2_BUCKET_NAME（如 tgjiema-backup）
#    3. 回到 R2 Overview 页面 → 右上角 Manage R2 API Tokens
#    4. 点击 Create API Token → 权限选「Object Read & Write」
#    5. 创建后会显示 Access Key ID 和 Secret Access Key（仅显示一次，务必保存）
#    6. R2_ACCOUNT_ID 在 R2 Overview 页面顶部，或从 Workers & Pages 页面右侧获取
#    7. R2_ENDPOINT 格式：{account_id}.r2.cloudflarestorage.com
#       （只填主机名，不要加 https:// 前缀，不要用反引号包裹）
#    8. 将 DB_BACKUP_ENABLED 设为 true 以启用自动备份
# -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tgjiema-backup
R2_ENDPOINT=

# 数据库备份开关和间隔（分钟）
DB_BACKUP_ENABLED=false
DB_BACKUP_INTERVAL_MINUTES=360
# R36 H7: 备份 AES-256-GCM 信封加密 KEK(base64, 32 字节)
# 未配置时备份降级为明文(商用环境必须配置)
# 生成命令: python -c "from services.backup_crypto import generate_kek; print(generate_kek())"
BACKUP_KEK=
# R37 P1-4: 备份强制加密开关
# true(生产推荐): KEK 不可用时停止备份服务,绝不上传明文
# false(默认,本地开发): 允许明文降级(仅 warning)
BACKUP_ENCRYPTION_REQUIRED=false
# R37 P1-6: KEK 密钥管理(生产推荐使用 systemd credentials 或 Secret Manager,不进入 .env)
# 优先级 1(生产推荐): BACKUP_KEK_FILE 指向 systemd credentials 文件路径
#   systemd 配置: LoadCredential=BACKUP_KEK:/path/to/kek_file
#   文件路径: /run/credentials/tgjiema-db_backup.service/BACKUP_KEK
#   文件内容: base64 编码的 32 字节 KEK
# 优先级 2(本地开发): BACKUP_KEK 环境变量(上方)
# R37 P1-6: 密钥轮转期间的双 key 解密窗口
# 配置 BACKUP_KEK_PREVIOUS(或 BACKUP_KEK_PREVIOUS_FILE)后,解密时会先尝试当前 KEK,
# 失败后回退到旧 KEK,保持足够长的轮转窗口覆盖所有增量备份周期 + 恢复演练
# 轮转流程: 1)生成新 KEK → 2)旧 KEK 写入 PREVIOUS → 3)新 KEK 写入主配置
#   → 4)验证所有旧备份已用新 KEK 重新加密 → 5)移除 PREVIOUS 配置
# BACKUP_KEK_FILE=
# BACKUP_KEK_PREVIOUS=
# BACKUP_KEK_PREVIOUS_FILE=

# -------------------------------------------------------
#  会员每日解码配额（-1 = 不限）
# -------------------------------------------------------
FREE_DAILY_QUOTA=3
BASIC_DAILY_QUOTA=20
PREMIUM_DAILY_QUOTA=-1

# 外部码每日配额（0=禁止，-1=不限）
FREE_EXTERNAL_DAILY_QUOTA=0
BASIC_EXTERNAL_DAILY_QUOTA=-1
PREMIUM_EXTERNAL_DAILY_QUOTA=-1

# -------------------------------------------------------
#  Telegram 用户中继（外部码解码）
#  中继账号通过 admin_bot /relay_add 添加，只需输入手机号
#  api_id 和 api_hash 从下方读取，无需每次输入
#  在 https://my.telegram.org 申请 API 密钥
# -------------------------------------------------------
RELAY_API_ID=0
RELAY_API_HASH=
# 中继账号加密密钥（必填！用于加密 API_HASH 存储，启动时自动校验格式）
# 生成密钥: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 注意：密钥一旦设定不可更改，否则已加密的 API_HASH 将无法解密
RELAY_ENCRYPTION_KEY=

# -------------------------------------------------------
#  白名单配置（可选，支持热修改）
#  逗号分隔的 Telegram 用户 ID，可留空
#  推荐通过 admin_bot 命令热修改（DB 配置优先于环境变量）：
#    /relay_whitelist add <用户ID>     — 添加中继账号
#    /collector_whitelist add <用户ID> — 添加采集器账号
#  获取用户 ID：私聊 @userinfobot
# -------------------------------------------------------
# 中继账号白名单：仅这些账号可向 Up Bot 发送 EXTERNAL_RELAY/EXTERNAL_DONE
# 未配置时所有 EXTERNAL_RELAY 请求将被拒绝（安全默认拒绝）
RELAY_ACCOUNT_IDS=
# 采集器账号白名单：仅这些账号可向主系统推送采集结果
# 用于外挂采集器（如 tgjiema-code-crawler）对接鉴权
COLLECTOR_ACCOUNT_IDS=

# -------------------------------------------------------
#  文件码前缀（可选）
# -------------------------------------------------------
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  速率限制
# -------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_PER_USER_PER_MINUTE=10

# -------------------------------------------------------
#  日志级别（DEBUG / INFO / WARNING / ERROR）
# -------------------------------------------------------
LOG_LEVEL=INFO

# -------------------------------------------------------
#  上传选项默认值
# -------------------------------------------------------
DEFAULT_PROTECT_CONTENT=false
DEFAULT_FILE_TTL_DAYS=0  # 0=永久有效

# -------------------------------------------------------
#  可调参数
# -------------------------------------------------------
PENDING_TTL=300                      # 外部码等待超时（秒）
SEND_CONCURRENCY=25                  # Dsp 发送并发上限
PAGE_SIZE=10                         # 分页大小
MEDIA_GROUP_BUFFER_WAIT=3.0          # 媒体组缓冲等待时间（秒）
EXTERNAL_MEDIA_GROUP_TTL=300         # 外部媒体组 TTL（秒）
CACHE_STORE_CLEANUP_DAYS=30          # 本地缓存清理天数

# 数据保留与清理（替代废弃的 CRDB TTL job，0 RU 起）
DATA_RETENTION_DAYS=7                # decode_logs/jobs 保留天数
CRDB_CLEANUP_CRON_HOURS=6            # CRDB 端清理周期（小时）
CRDB_CLEANUP_BATCH_SIZE=5000         # 单批删除条数上限

# 环形拓扑轮转参数（也可通过 admin_bot /rotation_set 热更新）
ROTATION_ACTIVE_WINDOW_SIZE=3        # 同一时刻活跃频道数
ROTATION_FILES_PER_SLOT=500          # 每槽位文件数上限
ROTATION_TIME_PER_SLOT=3600          # 每槽位最多使用时间（秒）

# Dsp 降级兜底（Mon 不可用时）
CHANNEL_FAILURE_THRESHOLD=3          # 60 秒内失败 N 次触发降级
CHANNEL_FAILURE_WINDOW=60            # 统计窗口（秒）

# 进程管理
RESTART_COOLDOWN=600                 # 子进程崩溃冷却期（秒）
# MAX_RESTART_COUNT=3                 # 窗口内最大重启次数
# MAX_RESTART_WINDOW=300              # 重启计数窗口（秒）

# 动态限速（队列长度自适应）
RATE_LIMIT_BASE_DELAY=0.2            # 空闲时基础延迟（秒）
RATE_LIMIT_MAX_DELAY=3.0             # 高峰期最大延迟（秒）
RATE_LIMIT_THRESHOLD_LOW=10          # 低负载阈值
RATE_LIMIT_THRESHOLD_HIGH=30         # 高负载阈值

# 数据库连接池（R36 §6.4: 业务 Bot min_size=0 + max_size=2 + application_name）
# min_size=0: 空闲时关闭所有连接,降低空载 RU 消耗(目标 <5,000 RU/天)
# max_size=2: 业务 Bot 单进程最多 2 连接;crdb_sync 服务可独立配置更高
CRDB_POOL_MIN_SIZE=0
CRDB_POOL_MAX_SIZE=2
# application_name 前缀,实际值为 f"{前缀}-{SERVICE_ROLE}"(如 tgjiema-up)
CRDB_APPLICATION_NAME_PREFIX=tgjiema

# -------------------------------------------------------
#  Redis ACL 凭证（R39 P0-2: 替代旧 REDIS_WRITER_PWD / REDIS_READER_PWD）
#  config/redis/users.acl.template 中使用 [REDIS_WRITER_PASSWORD] / [REDIS_READER_PASSWORD]
#  / [REDIS_HEALTH_PASSWORD] / [REDIS_ADMIN_PASSWORD] 占位符,deploy_vps_per_bot.sh
#  部署时 render_acl.sh sed 替换为真实值。
#  部署后各服务的 REDIS_URL 应使用:
#    redis://tgjiema_writer:<REDIS_WRITER_PASSWORD>@redis:6379/0 (写服务)
#    redis://tgjiema_reader:<REDIS_READER_PASSWORD>@redis:6379/0 (只读服务)
#    redis://tgjiema_admin:<REDIS_ADMIN_PASSWORD>@redis:6379/0 (mon_bot/admin_bot/admin 后台)
#  R41 P0-3 fail-closed: 任一变量未设置 → render_acl.sh exit 1,
#                        docker compose 启动失败(不再回退默认密码)。
#  R41 P1-9: 新增 REDIS_ADMIN_PASSWORD(tgjiema_admin 用户,mon_bot/admin_bot/admin 后台使用,
#            需要 XAUTOCLAIM/EVAL/XTRIM 等管理命令)。
#  未配置时 docker compose up 因 ${VAR:?...} 必填语法直接失败(强烈推荐显式配置)。
# -------------------------------------------------------
REDIS_WRITER_PASSWORD=
REDIS_READER_PASSWORD=
REDIS_HEALTH_PASSWORD=
REDIS_ADMIN_PASSWORD=

# -------------------------------------------------------
#  Redis + Writer 进程架构（方案B v2，消除 SQLite 锁冲突，零数据丢失）
#  原理：写操作先入 Redis Stream（<0.1ms 返回），db_writer 进程
#        通过 XREADGROUP 消费（消息进入 pending 不删除），SQLite
#        提交后 XACK 确认。崩溃后 XAUTOCLAIM 回收 pending 消息，
#        配合 writer_inbox 幂等表实现 exactly-once 语义。
#  降级：WRITER_MODE=sqlite 时直写 SQLite（旧逻辑，本地开发用）
#  注意：WRITER_MODE=redis 时需同时配置 REDIS_URL 才生效
#
#  R33 修复：从 Redis List BRPOP 改为 Streams Consumer Group
#    - XADD: 写操作推入 Stream（带 message_id 幂等键）
#    - XREADGROUP: 消费消息（进入 pending 不删除）
#    - XACK: SQLite 提交后确认（消息从 pending 删除）
#    - XAUTOCLAIM: 回收 pending >30s 的消息（崩溃恢复）
#    - writer_inbox: SQLite 幂等表，防止崩溃恢复后重复执行
#    - 非幂等操作（increment/refund）移至直写，避免重放二次扣减
#
#  Redis 持久化（部署脚本自动配置，见 deploy_vps_per_bot.sh）：
#    appendonly yes          # 启用 AOF
#    appendfsync everysec    # 每秒 fsync（最多丢 1 秒数据）
#    maxmemory-policy noeviction  # 内存满时不逐出写入（返回错误）
# -------------------------------------------------------
# WRITER_MODE=redis                          # redis=启用Writer进程(需REDIS_URL), sqlite=降级直写
# WRITER_STREAM_KEY=tgjiema:writer:stream   # R33: Redis Stream key(替代 List)
# WRITER_CONSUMER_GROUP=tgjiema-writer-group  # R33: Consumer Group 名(db_writer 通过此 group 消费)
# WRITER_CONSUMER_NAME=db_writer             # R33: Consumer 名(区分不同 db_writer 实例)
# WRITER_RECLAIM_IDLE_MS=30000               # R33: pending 消息回收阈值(ms),超过此时间被 XAUTOCLAIM 回收
# WRITER_BATCH_SIZE=10                       # 单次 XREADGROUP 批量
# WRITER_QUEUE_ALERT_THRESHOLD=1000          # pending 积压告警阈值
# WRITER_DEAD_STREAM_KEY=tgjiema:writer:dead # R33: 死信队列 Stream key(替代 List,支持重试闭环)
# WRITER_DEAD_MAX_ATTEMPTS=3                 # R33: 死信最大重试次数(超过后永久死信)
# WRITER_DEAD_RETRY_DELAY=60                 # R33: 死信重试延迟(秒,失败后延迟 XADD 回主队列)
# DB_WRITER_SERVICE_NAME=tgjiema-db_writer   # db_writer systemd 服务名(monitor监控用)
# 读缓存 TTL（秒），按数据类型分级
# WRITER_CACHE_TTL_QUOTA=5                   # 用户配额(高频变更)
# WRITER_CACHE_TTL_FILE_RECORD=30            # 文件记录
# WRITER_CACHE_TTL_CODE=30                   # 验证码
# WRITER_CACHE_TTL_USER=30                   # 用户记录
# WRITER_CACHE_TTL_CELLS=10                  # 全量cells
# WRITER_CACHE_TTL_BOT_HB=5                  # Bot心跳(高频变更)
# WRITER_CACHE_TTL_KV=60                     # KV存储(低频变更)

# -------------------------------------------------------
#  高级可选参数（以下参数均有默认值，无需修改即可运行）
#  仅在需要精细调优时取消注释并修改
# -------------------------------------------------------

# 监控检查间隔（秒）
# MON_CHECK_INTERVAL=60

# 配额同步间隔（秒，减少 CRDB RU 消耗）
# QUOTA_SYNC_INTERVAL=300

# 拓扑初始化重试次数
# TOPOLOGY_SEED_RETRIES=3

# 中继池负载均衡权重（通常无需修改）
# RELAY_WEIGHT_AVG_WAIT=0.4
# RELAY_WEIGHT_TODAY_REQ=0.4
# RELAY_WEIGHT_GAP=0.2
# RELAY_NORM_AVG_WAIT=1000.0
# RELAY_NORM_TODAY_REQ=50000.0
# RELAY_NORM_GAP=3600.0

# 缓存参数（条目数 / TTL 秒）
# CACHE_USER_MAX_SIZE=1000
# CACHE_USER_TTL=10800
# CACHE_FILE_MAX_SIZE=1000
# CACHE_FILE_TTL=300
# CACHE_CONFIG_MAX_SIZE=100
# CACHE_CONFIG_TTL=600
# CACHE_NEGATIVE_TTL=60
# CACHE_REQUEST_COUNT_FLUSH=900
# CACHE_DECODE_LOG_FLUSH=3600

# Admin Web 安全参数
# ADMIN_LOGIN_WINDOW=300              # 登录失败计数窗口（秒）
# ADMIN_LOGIN_MAX_FAIL=5              # 窗口内最大失败次数
# ADMIN_COUNT_CACHE_TTL=60            # count 缓存 TTL（秒）
# ADMIN_SEARCH_MAX_LENGTH=50          # 搜索输入最大长度
# ADMIN_PAGE_SIZE=20                  # 默认分页大小
# ADMIN_FILES_PAGE_SIZE=50            # 文件列表分页大小

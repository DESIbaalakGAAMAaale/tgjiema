# ============================================================
#  TG文件解码器机器人系统 - 环境变量配置文件
#  使用方式: 复制此文件为 .env 并填入真实值
# ============================================================

# -------------------------------------------------------
#  机器人 Token（必填，从 @BotFather 获取）
# -------------------------------------------------------
# JSON 格式，每个机器人一个独立 Token
# - UPLOAD_BOT:   上传机器人，接收用户文件
# - DECODER_BOT:  解码机器人，生成/验证文件码（系统核心）
# - SENDER_BOT:   文件发送机器人，执行文件转发
# - BACKUP_BOT_1: 备份机器人1（负责备份组1的频道）
# - BACKUP_BOT_2: 备份机器人2（负责备份组2的频道）
# - BACKUP_BOT_3: 备份机器人3（负责备份组3的频道）
BOT_TOKENS={"UPLOAD_BOT":"YOUR_UPLOAD_BOT_TOKEN","DECODER_BOT":"YOUR_DECODER_BOT_TOKEN","SENDER_BOT":"YOUR_SENDER_BOT_TOKEN","BACKUP_BOT_1":"YOUR_BACKUP_BOT_1_TOKEN","BACKUP_BOT_2":"YOUR_BACKUP_BOT_2_TOKEN","BACKUP_BOT_3":"YOUR_BACKUP_BOT_3_TOKEN"}

# -------------------------------------------------------
#  频道 ID（必填，Telegram 频道数字 ID，负值）
# -------------------------------------------------------
# 主存储频道：上传机器人将用户文件转存到这里（Telegram 频道）
MAIN_STORAGE_CHANNEL_ID=-1000000000000
# 解码机器人自身的用户ID（用于接收上传机器人的内部通知消息）
DECODER_BOT_CHAT_ID=000000000

# -------------------------------------------------------
#  备份频道分组（视频文件通过Telegram频道转发备份）
# -------------------------------------------------------
# 备份机器人1负责的频道列表（JSON数组，留空则不使用）
BACKUP_CHANNELS_GROUP_1=[]
# 备份机器人2负责的频道列表（JSON数组，留空则不使用）
BACKUP_CHANNELS_GROUP_2=[]
# 备份机器人3负责的频道列表（JSON数组，留空则不使用）
BACKUP_CHANNELS_GROUP_3=[]

# -------------------------------------------------------
#  Cloudflare D1 数据库配置（必填）
# -------------------------------------------------------
# Cloudflare 账户 ID（在 Cloudflare Dashboard 首页右侧）
D1_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
# D1 数据库 ID（在 D1 面板中创建数据库后获取）
D1_DATABASE_ID=YOUR_D1_DATABASE_ID
# Cloudflare API Token（需要 D1 读写权限，在 用户 Profile > API Tokens 创建）
D1_API_TOKEN=YOUR_CF_API_TOKEN

# -------------------------------------------------------
#  Cloudflare R2 对象存储配置（必填，用于 D1 数据库定期备份）
# -------------------------------------------------------
# Cloudflare 账户 ID（同上）
R2_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
# R2 Access Key ID（在 R2 面板 > Manage R2 API Tokens 创建）
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# R2 存储桶名称
R2_BUCKET_NAME=tgjiema-backup
# R2 自定义域名（可选，留空则使用默认 Cloudflare 域名）
R2_ENDPOINT=

# -------------------------------------------------------
#  D1 数据库备份到 R2 的间隔（分钟）
# -------------------------------------------------------
DB_BACKUP_INTERVAL_MINUTES=60

# -------------------------------------------------------
#  Web 管理后台配置
# -------------------------------------------------------
# 后台监听地址（设为 0.0.0.0 可外网访问，但务必修改密码）
ADMIN_WEB_HOST=127.0.0.1
# 后台监听端口
ADMIN_WEB_PORT=8080
# 登录账号
ADMIN_USERNAME=admin
# 登录密码（初次部署请务必修改）
ADMIN_PASSWORD=admin123

# -------------------------------------------------------
#  会员每日解码次数配额（总配额，含本系统码 + 外部码）
# -------------------------------------------------------
# 免费用户：每天可解码次数，-1 表示不限
FREE_DAILY_QUOTA=3
# 基础会员：每天可解码次数
BASIC_DAILY_QUOTA=20
# 高级会员：每天可解码次数，-1 表示无限
PREMIUM_DAILY_QUOTA=-1

# -------------------------------------------------------
#  外部码每日配额（独立于总配额，0=禁止，-1=不限）
# -------------------------------------------------------
# 免费用户：每天可解码非本系统码的次数（设为 0 则禁止外部解码）
FREE_EXTERNAL_DAILY_QUOTA=0
# 基础会员：每天可解码非本系统码的次数（-1 不限）
BASIC_EXTERNAL_DAILY_QUOTA=-1
# 高级会员：每天可解码非本系统码的次数（-1 不限）
PREMIUM_EXTERNAL_DAILY_QUOTA=-1

# -------------------------------------------------------
#  文件码格式
# -------------------------------------------------------
# 文件码自定义开头（最终格式: <开头>_<12位随机码>_<文件类型数量>）
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  速率限制（防滥用）
# -------------------------------------------------------
# 全局每秒最大请求数（所有用户合计）
RATE_LIMIT_GLOBAL_PER_SECOND=30
# 单个用户每分钟最大请求数
RATE_LIMIT_PER_USER_PER_MINUTE=10

# -------------------------------------------------------
#  日志级别
# -------------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
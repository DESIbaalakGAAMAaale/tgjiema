# ============================================================
#  TG文件解码器机器人系统 - 环境变量配置文件
#  使用方式: 复制此文件为 .env 并填入真实值
# ============================================================

# -------------------------------------------------------
#  机器人 Token（必填，从 @BotFather 获取，每行一个）
#  将对应机器人的 Bot Token 填入，暂不需要的留空即可
# -------------------------------------------------------
UPLOAD_BOT_TOKEN=YOUR_UPLOAD_BOT_TOKEN
DECODER_BOT_TOKEN=YOUR_DECODER_BOT_TOKEN
SENDER_BOT_TOKEN=YOUR_SENDER_BOT_TOKEN
BACKUP_BOT_1_TOKEN=
BACKUP_BOT_2_TOKEN=
BACKUP_BOT_3_TOKEN=
# 提示：启动后也可通过管理员机器人 /add_backup_bot /remove_backup_bot
# 动态管理 Token（存储在数据库），但修改后需要重启对应进程生效。
# 管理员机器人：通过 Telegram 管理系统的管理后台（可选）
# 需要同时配置 ADMIN_TELEGRAM_ID 指定管理员用户
ADMIN_BOT_TOKEN=
# 管理员用户的 Telegram User ID（用于管理员机器人权限校验）
# 获取方式：给 @userinfobot 或 @getidsbot 发送任意消息即可看到
ADMIN_TELEGRAM_ID=0

# -------------------------------------------------------
#  频道 ID（必填，Telegram 频道数字 ID，负值）
# -------------------------------------------------------
# 主存储频道：上传机器人将用户文件转存到这里（Telegram 频道）
# 获取方式：在 Telegram 频道中转发任意消息给 @userinfobot 或 @getidsbot 即可看到
MAIN_STORAGE_CHANNEL_ID=-1000000000000
# 解码机器人自身的用户ID（用于接收上传机器人的内部通知消息）
DECODER_BOT_CHAT_ID=000000000

# -------------------------------------------------------
#  备份频道分组（视频文件通过 Telegram 频道转发备份）
#  对应 BACKUP_BOT_N_TOKEN 为空时，该组自动跳过
#
#  获取频道 ID：在目标 Telegram 频道中转发任意消息给
#  @userinfobot 或 @getidsbot，回复中的 chat id 即为频道 ID（负数）
#
#  配置格式：JSON 数组，每个元素为频道 ID（负整数）
#  示例（配置3个频道）：BACKUP_CHANNELS_GROUP_1=[-100123456789, -100987654321]
#  不使用时留空：BACKUP_CHANNELS_GROUP_1=[]
#
#  提示：启动后也可通过管理员机器人的 /add_channel 和 /remove_channel
#  命令动态管理备份频道，无需修改 .env 和重启。动态配置存储在数据库中。
# -------------------------------------------------------
BACKUP_CHANNELS_GROUP_1=[]
BACKUP_CHANNELS_GROUP_2=[]
BACKUP_CHANNELS_GROUP_3=[]

# -------------------------------------------------------
#  CockroachDB 数据库配置
#
#  获取步骤：
#  1. 访问 https://cockroachlabs.com 注册/登录 CockroachDB Cloud
#  2. Create Cluster → 选择 Basic (免费 5GB) 或 Standard 方案
#     → 选择云服务商 (GCP/AWS) 和区域
#     → Create Cluster
#  3. 创建完成后 → Connect → 选择 General connection string
#     → 复制完整连接字符串，将其中的 sslmode=verify-full 改为 sslmode=require
#     （verify-full 需要本地 CA 证书，require 仍加密但跳过证书链验证）
#     最终格式如：
#       postgresql://user:password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/defaultdb?sslmode=require&options=--cluster=your-cluster-name
#  4. 将修改后的连接字符串填入下方 COCKROACHDB_URL
#  5. 首次连接时会自动创建所有表，无需手动建表
#
#  注意：密码中如有特殊字符（@ : / ? # 等），需要 URL 编码
# -------------------------------------------------------
COCKROACHDB_URL=postgresql://user:password@host:26257/defaultdb?sslmode=require&options=--cluster=your-cluster-name

# -------------------------------------------------------
#  强制关注频道（可选，设为 0 则禁用）
#
#  1. 创建一个 Telegram 公开频道作为官方频道
#  2. 将三个机器人都设为频道管理员（需要能查成员状态）
#  3. 频道 ID 获取：转发频道消息到 @userinfobot，复制数字 ID
#     填入 FORCE_JOIN_CHANNEL_ID（负数，如 -1001234567890）
#  4. 频道邀请链接填入 FORCE_JOIN_CHANNEL_LINK
#     （如 https://t.me/your_channel）
# -------------------------------------------------------
FORCE_JOIN_CHANNEL_ID=0
FORCE_JOIN_CHANNEL_LINK=

# -------------------------------------------------------
#  三个机器人的公开用户名（不带 @ 符号）
#  用于互相提醒用户启动所有机器人
# -------------------------------------------------------
UPLOAD_BOT_USERNAME=
DECODER_BOT_USERNAME=
SENDER_BOT_USERNAME=

# -------------------------------------------------------
#  Cloudflare R2 对象存储配置（用于 D1 数据库定期备份）
#
#  获取步骤：
#  1. 登录 https://dash.cloudflare.com
#  2. 左侧菜单 R2 Object Storage → Manage R2 API Tokens
#     → Create API Token
#     → Token name 随意填，权限选择 "Edit"
#     → 创建后得到 Access Key ID 和 Secret Access Key
#     → 填入下方 R2_ACCESS_KEY_ID 和 R2_SECRET_ACCESS_KEY
#  3. R2 Object Storage → 创建一个存储桶（如 tgjiema-backup）
#     → 填入 R2_BUCKET_NAME
#  4. Dashboard 首页右侧 Account ID，填入 R2_ACCOUNT_ID
#  5. R2_ENDPOINT 留空使用默认域名，或填入自定义域名（需已绑定）
# -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tgjiema-backup
R2_ENDPOINT=

# -------------------------------------------------------
#  D1 数据库备份到 R2 配置
# -------------------------------------------------------
# 是否启用数据库定期备份（设为 false 可完全禁用）
DB_BACKUP_ENABLED=false
# 备份间隔（分钟），DB_BACKUP_ENABLED=true 时生效
DB_BACKUP_INTERVAL_MINUTES=60

# -------------------------------------------------------
#  Web 管理后台配置
# -------------------------------------------------------
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -------------------------------------------------------
#  会员每日解码次数配额（-1 表示不限）
# -------------------------------------------------------
FREE_DAILY_QUOTA=3
BASIC_DAILY_QUOTA=20
PREMIUM_DAILY_QUOTA=-1

# -------------------------------------------------------
#  外部码每日配额（0=禁止，-1=不限）
# -------------------------------------------------------
FREE_EXTERNAL_DAILY_QUOTA=0
BASIC_EXTERNAL_DAILY_QUOTA=-1
PREMIUM_EXTERNAL_DAILY_QUOTA=-1

# -------------------------------------------------------
#  Telegram 用户中继（用于外部码解码）
#  通过登录一个真实 Telegram 账号来突破 bot-to-bot 私聊限制
#
#  获取 API ID 和 API Hash：
#  1. 用任意手机号注册一个 Telegram 账号（建一个小号）
#  2. 打开 https://my.telegram.org/auth
#  3. 用该手机号登录 → API development tools
#  4. 创建应用，获取 api_id 和 api_hash
#  5. RELAY_PHONE 填该账号的手机号（含国家码，如 +8613800138000）
#  6. 首次启动时终端会提示输入 Telegram 验证码
#
#  不填则不启用中继功能，外部码解码回退到手动模式
# -------------------------------------------------------
RELAY_API_ID=0
RELAY_API_HASH=
RELAY_PHONE=

# -------------------------------------------------------
#  AI 驱动外部机器人交互（可选）
#  用于智能处理外部机器人的翻页按钮和媒体组整合
#  支持 OpenAI 兼容格式的 API（OpenAI / Claude / 本地大模型等均可）
#
#  配置后，UserRelay 收到外部机器人回复时，会将消息摘要（类型/数量/按钮布局）
#  发给 AI，由 AI 判断：是否点击翻页按钮、是否等待、还是结束收集。
#
#  AI 看到的数据已脱敏：只含消息类型、文字、按钮位置（row:col:data:text），
#  不会暴露文件内容、file_id、Token 等敏感信息。
#
#  不配则自动回退到内置关键词匹配模式（仅支持"下一页"/"next"等常见文字）
# -------------------------------------------------------
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# -------------------------------------------------------
#  文件码格式
# -------------------------------------------------------
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  速率限制
# -------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_PER_USER_PER_MINUTE=10

# -------------------------------------------------------
#  日志级别
# -------------------------------------------------------
LOG_LEVEL=INFO

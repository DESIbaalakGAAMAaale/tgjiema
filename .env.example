# ============================================================
#  TG文件解码器 — 环境变量配置
#  架构：环形冗余 v2（up / idx / dsp / mon / admin_bot）
#
#  部署流程：
#   1. 复制此文件为 .env 并填入真实值
#   2. 创建 45 个 Telegram 频道，编辑 config/groups.yaml
#   3. python config/generate_topology.py   # 自动生成 topology.yaml
#   4. python admin/seed_topology.py        # 写入数据库
#   5. python run_all.py                    # 启动所有服务
# ============================================================

# -------------------------------------------------------
#  机器人 Token（必填，5 个 Bot）
#  从 @BotFather 创建机器人后获取 Token 填入对应行
# -------------------------------------------------------
UPLOAD_BOT_TOKEN=YOUR_UPLOAD_BOT_TOKEN
DECODER_BOT_TOKEN=YOUR_DECODER_BOT_TOKEN
SENDER_BOT_TOKEN=YOUR_SENDER_BOT_TOKEN
ADMIN_BOT_TOKEN=
MON_BOT_TOKEN=
ADMIN_TELEGRAM_ID=0

# -------------------------------------------------------
#  频道 ID（兜底频道，在环形拓扑加载前使用）
# -------------------------------------------------------
MAIN_STORAGE_CHANNEL_ID=-1000000000000
DECODER_BOT_CHAT_ID=000000000

# -------------------------------------------------------
#  Mon 监控配置
# -------------------------------------------------------
MON_CHECK_INTERVAL=60

# -------------------------------------------------------
#  环形拓扑槽位：编辑 config/groups.yaml 即可
#  groups.yaml 只需填每组的 3 个 channel_id
#  运行 generate_topology.py 后生成 topology.yaml
# -------------------------------------------------------

# -------------------------------------------------------
#  CockroachDB 数据库
# -------------------------------------------------------
COCKROACHDB_URL=postgresql://user:password@host:26257/defaultdb?sslmode=require&options=--cluster=your-cluster-name

# -------------------------------------------------------
#  强制关注频道（可选，设为 0 则禁用）
# -------------------------------------------------------
FORCE_JOIN_CHANNEL_ID=0
FORCE_JOIN_CHANNEL_LINK=

# -------------------------------------------------------
#  三个 Bot 的公开用户名（不带 @）
# -------------------------------------------------------
UPLOAD_BOT_USERNAME=
DECODER_BOT_USERNAME=
SENDER_BOT_USERNAME=

# -------------------------------------------------------
#  Cloudflare R2 对象存储（数据库定期备份，可选）
# -------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tgjiema-backup
R2_ENDPOINT=

# -------------------------------------------------------
#  数据库备份到 R2
# -------------------------------------------------------
DB_BACKUP_ENABLED=false
DB_BACKUP_INTERVAL_MINUTES=60

# -------------------------------------------------------
#  Web 管理后台
# -------------------------------------------------------
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -------------------------------------------------------
#  会员每日解码配额（-1 = 不限）
# -------------------------------------------------------
FREE_DAILY_QUOTA=3
BASIC_DAILY_QUOTA=20
PREMIUM_DAILY_QUOTA=-1

# -------------------------------------------------------
#  外部码每日配额（0=禁止，-1=不限）
# -------------------------------------------------------
FREE_EXTERNAL_DAILY_QUOTA=0
BASIC_EXTERNAL_DAILY_QUOTA=-1
PREMIUM_EXTERNAL_DAILY_QUOTA=-1

# -------------------------------------------------------
#  Telegram 用户中继（外部码解码，可选）
# -------------------------------------------------------
RELAY_API_ID=0
RELAY_API_HASH=
RELAY_PHONE=

# -------------------------------------------------------
#  文件码格式
# -------------------------------------------------------
FILE_CODE_PREFIX=tgwenjian

# -------------------------------------------------------
#  速率限制
# -------------------------------------------------------
RATE_LIMIT_GLOBAL_PER_SECOND=30
RATE_LIMIT_PER_USER_PER_MINUTE=10

# -------------------------------------------------------
#  日志级别
# -------------------------------------------------------
LOG_LEVEL=INFO

# ── 以下为旧版 backup_bot 配置（已废弃，可忽略）────────────────
# 这些字段已被环形冗余架构替代，无需填写